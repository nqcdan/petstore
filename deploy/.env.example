# Copy to deploy/.env (never commit it) and fill in every value.
PETSTORE_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Public URL of Keycloak realm, as seen by browsers (this is the token issuer)
KEYCLOAK_ISSUER_URI=https://auth.example.com/realms/petstore
# Public origin of the web frontend, no trailing slash
PETSTORE_WEB_ORIGIN=https://shop.example.com
# true loads demo customers and orders (shared public demo); false (default) for a real store
PETSTORE_SEED_DEMO=true
# true publishes the OpenAPI document and Swagger UI
PETSTORE_API_DOCS=false
# Optional: Gmail address and app password for the legacy JSP mail features
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional image tag
PETSTORE_VERSION=latest
