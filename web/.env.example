# Keycloak (public client, Authorization Code + PKCE)
VITE_KEYCLOAK_URL=https://sso.example.com
VITE_KEYCLOAK_REALM=petstore
VITE_KEYCLOAK_CLIENT_ID=petstore-web
# Base URL of the REST API (pha A), "/api/v1" when served behind the same origin
VITE_API_BASE=/api/v1
# "true": MSW answers every /api/v1 call and login is a local stub (no Keycloak needed)
VITE_MOCK=true
# Show the public demo accounts box on the landing and login prompt
VITE_SHOW_DEMO_ACCOUNTS=true
